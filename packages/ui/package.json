    "postcss": "^8.4.47",
    "rimraf": "^6.0.1",
    "storybook": "8.6.18",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
