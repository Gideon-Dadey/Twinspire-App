{
  "name": "@twinspire/ui",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens.ts",
      "import": "./src/tokens.ts"
    },
    "./tailwind-preset": {
      "import": "./tailwind.preset.cjs",
      "require": "./tailwind.preset.cjs",
      "default": "./tailwind.preset.cjs"
    },
    "./styles/globals.css": "./src/styles/globals.css"
  },
  "files": ["src", "tailwind.preset.cjs"],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "clean": "rimraf dist .turbo storybook-static"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
