# =============================================================================
# TwinSpire — Root environment template
# Copy to .env (for docker-compose) and to apps/*/.env for each app.
# Never commit a real .env file.
# =============================================================================

# ---- General ----------------------------------------------------------------
NODE_ENV=development
TZ=UTC

# ---- Frontend (apps/frontend/.env.local) ------------------------------------
NEXT_PUBLIC_APP_NAME=TwinSpire
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_DEFAULT_LOCALE=en-US
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Backend (apps/backend/.env) --------------------------------------------
PORT=4000
HOST=0.0.0.0
APP_NAME=TwinSpire
APP_URL=http://localhost:3000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
LOG_PRETTY=true
TRUST_PROXY=1

# MongoDB
DATABASE_URL=mongodb://twinspire:twinspire@localhost:27017/twinspire?authSource=admin
DATABASE_NAME=twinspire

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=twinspire:

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=twinspire

# JWT
JWT_ACCESS_SECRET=replace-with-64-byte-hex-secret-for-access-tokens
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-different-64-byte-hex-secret-for-refresh-tokens
JWT_REFRESH_TTL=30d
JWT_ISSUER=twinspire
JWT_AUDIENCE=twinspire-clients

# Cookies
COOKIE_SECRET=replace-with-32-byte-secret
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# AWS / S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=twinspire-media
AWS_S3_PUBLIC_URL=

# Email (Nodemailer)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="TwinSpire <no-reply@twinspire.dev>"
EMAIL_REPLY_TO=support@twinspire.dev

# Payments — Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payments — PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# OAuth — Social login
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
