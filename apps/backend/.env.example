# Copy this file to apps/backend/.env and fill in the values.
# See the root .env.example for the full list of supported variables.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_NAME=TwinSpire
APP_URL=http://localhost:3000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
LOG_PRETTY=true
TRUST_PROXY=1

DATABASE_URL=mongodb://twinspire:twinspire@localhost:27017/twinspire?authSource=admin
DATABASE_NAME=twinspire

REDIS_URL=redis://localhost:6379
REDIS_PREFIX=twinspire:

ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_PRODUCT_INDEX=twinspire-products
ELASTICSEARCH_TLS_REJECT_UNAUTHORIZED=true

JWT_ACCESS_SECRET=development-only-access-secret-please-replace-with-64-byte-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=development-only-refresh-secret-please-replace-with-64-byte-hex
JWT_REFRESH_TTL=30d
JWT_ISSUER=twinspire
JWT_AUDIENCE=twinspire-clients

COOKIE_SECRET=development-only-cookie-secret-32-bytes-please-replace
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Commerce ---
TAX_RATE_DEFAULT=0
FREE_SHIPPING_THRESHOLD=75
SHIPPING_FLAT_RATE=8.99
ORDER_CART_TTL_DAYS=30
GUEST_CART_COOKIE=ts_cart

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-10-28.acacia

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
